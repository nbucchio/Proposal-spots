# Example environment variables for Proposal Spots.
# Copy to .env for local dev, and set the real values in Vercel → Settings →
# Environment Variables for production. NEVER commit real secrets (.env is
# gitignored).

# --- Existing site integrations ---
UNSPLASH_ACCESS_KEY=
AIRTABLE_TOKEN=
AIRTABLE_API_KEY=

# --- Draft preview links (api/spot-preview) ---
# Secret key that unlocks /spots/<slug>?preview=<key> for DRAFT spots, so a
# listing can be shown to a partner exactly as it will look published without
# going live in the browse grid, search, or sitemap. Pick any hard-to-guess
# string. Anyone with the full preview link can view drafts, so treat it like
# a private link; rotate this value to invalidate all outstanding links.
PREVIEW_SECRET=

# --- Pinterest publishing integration (api/pinterest) ---
# App ID is public; defaults to 1568781 in code if unset.
PINTEREST_APP_ID=1568781
# SECRET — from developers.pinterest.com → My apps → Proposal Spots → Manage.
PINTEREST_APP_SECRET=
# Must EXACTLY match the redirect URI registered in the Pinterest app.
PINTEREST_REDIRECT_URI=https://www.proposalspots.com/api/pinterest/callback
# Which Pinterest API environment to use:
#   sandbox    = required while the app is on Trial access (default if unset)
#   production = only after Pinterest approves Standard access
# Tokens are environment-specific — switching this means reconnecting.
PINTEREST_MODE=sandbox
# Filled in after completing the OAuth flow at /api/pinterest/connect.
# (These must be SANDBOX tokens while PINTEREST_MODE=sandbox.)
PINTEREST_ACCESS_TOKEN=
PINTEREST_REFRESH_TOKEN=
# Optional: if set, /api/pinterest/publish requires this secret to run.
PINTEREST_PUBLISH_SECRET=
